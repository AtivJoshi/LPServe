+             pre["max_model_len"], pre["num_gpu_blocks"]),
+            ([16] * 4, 3, 64, 4, 64, 4))
+        self.assertEqual((driver.BLOCK_SIZE, driver.TENSOR_PARALLEL_SIZE,
+                          driver.PIPELINE_PARALLEL_SIZE, driver.LOAD_FORMAT,
+                          driver.TEMPERATURE, driver.IGNORE_EOS),
