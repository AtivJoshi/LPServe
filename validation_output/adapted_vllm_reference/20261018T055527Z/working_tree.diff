+            samples = engine._run_workers("execute_model", scheduler_outputs="o")
+        self.assertEqual(result, ("native", "add_seq", (1,), dict(seq="s")))
+        self.assertEqual([(s.seq_id, s.output_token) for s in samples], [(3, 11)])
