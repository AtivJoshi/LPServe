+def oracle_options(r):
+    opts = [None]
+    if r.decode_eligible:
+        opts.append(("decode",))
+    if r.prefill_eligible:
+        opts += [("prefill", c) for c in range(1, r.prefill_upper_bound + 1)]
+    if r.preemption_eligible:
