+def read_trace(run_dir):
+    import gzip
+    run_dir = Path(run_dir)
+    if (run_dir / "decision_trace.json.gz").exists():
+        with gzip.open(run_dir / "decision_trace.json.gz", "rt") as f:
+            return json.load(f)
+    return json.loads((run_dir / "decision_trace.json").read_text())
+
