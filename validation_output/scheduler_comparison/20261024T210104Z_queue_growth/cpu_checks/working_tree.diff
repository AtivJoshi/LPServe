+def write_json_gz(path, value):
+    """Deterministic gzip (no timestamp) of a JSON record."""
+    import gzip
+    with open(path, "wb") as raw, gzip.GzipFile(fileobj=raw, mode="wb",
+                                                mtime=0) as f:
+        f.write(json.dumps(value, indent=1).encode())
+
