+def lrs_validate(problem):
+    import lp_relaxation_scheduler as lrs
+    canonical = lrs.validate_problem(problem)
+    driver.check(not isinstance(canonical, lrs.Failure),
+                 f"retained problem failed validation: {canonical}")
+    return canonical
